<?xml version="1.0" encoding="UTF-8"?>
<!--
  pw-pal-devices.xml — soundcard-based stream capability map.

  All streams are DISABLED by default.  A stream is enabled only when
  the active sound card (read from /proc/asound/cards) matches one of
  the <soundcard> blocks that lists it.

  <soundcard name="...">
    The name attribute is a whitespace/comma-separated list of substrings.
    A card matches if ANY of those substrings is found in
    /proc/asound/cards.  This lets two boards that share the same
    sinks/sources be expressed in a single block.

    Example — two boards sharing speaker + mic streams:
      <soundcard name="qcs8275 monaco-evk">

  <stream node="...">
    node matches node.name in pw-pal-plugin.conf.
    Only streams listed inside a matching <soundcard> block are enabled.
-->
<pw-pal-devices>

    <!-- ── qcs8275 EVK (max98357a + dmic) ─────────────────────── -->
    <soundcard name="qcs8275">
        <stream node="pal_sink_speaker_ll" />
        <stream node="pal_sink_speaker_db" />
        <stream node="pal_sink_speaker_compress" />
        <stream node="pal_source_speaker_mic" />
        <stream node="pal_sink_dp_out_ll" />
        <stream node="pal_sink_dp_out_db" />
        <stream node="pal_sink_hdmi_out_ll" />
        <stream node="pal_sink_hdmi_out_db" />
    </soundcard>

    <!-- ── monaco-arduino-monza / gertrude (max98091) ──────────── -->
    <!-- shares speaker/mic streams with qcs8275 EVK above;         -->
    <!-- additionally supports headset via max98091                  -->
    <soundcard name="arduino-monza monaco-gertrude">
        <stream node="pal_sink_speaker_ll" />
        <stream node="pal_sink_speaker_db" />
        <stream node="pal_sink_speaker_compress" />
        <stream node="pal_sink_headset_ll" />
        <stream node="pal_sink_headset_db" />
        <stream node="pal_source_speaker_mic" />
        <stream node="pal_source_headset_mic" />
        <stream node="pal_sink_combined_ll" />
        <stream node="pal_sink_combined_db" />
    </soundcard>

    <!-- ── Add more soundcard blocks here for other boards ──────── -->

</pw-pal-devices>
